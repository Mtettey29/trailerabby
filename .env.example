# Clerk (https://dashboard.clerk.com)
# PRODUCTION keys (pk_live_ / sk_live_) — required for live deploy; Dashboard shows "Production"
# Development keys (pk_test_ / sk_test_) — local only; Dashboard shows "Development"
# Pull keys: npm run clerk:login && npm run clerk:env:prod
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# Optional — Platform API for `npm run clerk:config` in CI
# CLERK_PLATFORM_API_KEY=
# Used when building administrator overview links in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs time-limited view-only overview links (falls back to CLERK_SECRET_KEY)
GUEST_LINK_SECRET=

# SerpAPI free tier (https://serpapi.com/) — optional place search when adding locations.
# Map tiles use free CARTO/OSM (no Mapbox key). Enter coordinates manually if you skip this.
SERPAPI_API_KEY=

# Upstash Redis (required in production on Vercel)
# Vercel → Project → Storage → Marketplace → Upstash Redis → Connect
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV env names are also supported:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Local development: if Redis vars are empty, data is stored in .data/*.json
# npm run seed          → .data/trailers.json (from Fixed Assets CSV in repo root)
# npm run seed:locations → .data/locations.json
# npm run seed:drivers    → .data/drivers.json
# npm run seed:alerts     → .data/alerts.json
# npm run seed:maintenance → .data/maintenance.json
# npm run seed:users        → .data/users.json
# npm run seed:settings     → .data/settings.json
